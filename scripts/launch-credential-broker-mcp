#!/bin/bash
set -euo pipefail

repo_root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$repo_root" ]; then
  repo_root="$(cd "$(dirname "$0")/.." && pwd)"
fi

support_root="$HOME/Library/Application Support/MacBookCredentialBroker"
support_binary="$support_root/bin/macbook-credential-broker"

if [ ! -x "$support_binary" ]; then
  "$repo_root/scripts/install-credential-broker" >/dev/null
fi

exec "$support_binary" mcp
