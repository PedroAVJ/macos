#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
source_file="$repo_root/runtime/bin/macbook-credential-broker"
support_root="$HOME/Library/Application Support/MacBookCredentialBroker"
destination_dir="$support_root/bin"
destination_file="$destination_dir/macbook-credential-broker"

if [ ! -x "$source_file" ]; then
  echo "Credential broker binary is missing from this plugin." >&2
  exit 1
fi
codesign --verify --strict "$source_file"

mkdir -p "$destination_dir"
chmod 0700 "$support_root" "$destination_dir"

if [ -e "$destination_file" ]; then
  if codesign --verify --strict "$destination_file" >/dev/null 2>&1 \
    && cmp -s "$source_file" "$destination_file" \
    && "$destination_file" --version >/dev/null 2>&1; then
    echo "$destination_file"
    exit 0
  fi
  echo "Existing credential broker differs from this signed plugin release; refusing to overwrite it automatically." >&2
  exit 1
fi

temporary_file="$destination_dir/.macbook-credential-broker.installing.$$"
trap 'rm -f "$temporary_file"' EXIT
cp "$source_file" "$temporary_file"
chmod 0700 "$temporary_file"
codesign --verify --strict "$temporary_file"
mv "$temporary_file" "$destination_file"
trap - EXIT

echo "$destination_file"
