#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
source_file="$repo_root/native/MacBookCredentialBroker.swift"
output_dir="$repo_root/runtime/bin"
output_file="$output_dir/macbook-credential-broker"
build_dir="$(mktemp -d "${TMPDIR:-/tmp}/macbook-credential-broker-build.XXXXXX")"

cleanup() {
  rm -rf "$build_dir"
}
trap cleanup EXIT

sdk_path="$(xcrun --sdk macosx --show-sdk-path)"
mkdir -p "$output_dir"

for architecture in arm64 x86_64; do
  xcrun swiftc \
    -parse-as-library \
    -O \
    -whole-module-optimization \
    -target "${architecture}-apple-macos13.0" \
    -sdk "$sdk_path" \
    "$source_file" \
    -framework AppKit \
    -framework ApplicationServices \
    -framework Security \
    -o "$build_dir/macbook-credential-broker-$architecture"
done

xcrun lipo -create \
  "$build_dir/macbook-credential-broker-arm64" \
  "$build_dir/macbook-credential-broker-x86_64" \
  -output "$output_file"
chmod 0755 "$output_file"
codesign \
  --force \
  --sign - \
  --identifier com.pedroavj.macbook.credential-broker \
  --options runtime \
  --timestamp=none \
  "$output_file"

codesign --verify --strict --verbose=2 "$output_file"
file "$output_file"
